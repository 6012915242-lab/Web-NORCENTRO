# Credenciales locales (nunca se suben al repositorio)
.env
.env.*
/configuracion/factiliza.ini

# Archivos generados durante la ejecución
/storage/sessions/*
!/storage/sessions/.gitkeep
/public/img/motos/uploads/*
!/public/img/motos/uploads/.keep
*.log

# Backend Laravel: dependencias y archivos generados
/backend-laravel/.env
/backend-laravel/vendor/
/backend-laravel/node_modules/
/backend-laravel/public/build/
/backend-laravel/public/hot
/backend-laravel/storage/framework/sessions/*
/backend-laravel/storage/framework/views/*
/backend-laravel/storage/framework/cache/data/*
/backend-laravel/storage/logs/*
!/backend-laravel/storage/**/.gitignore
.phpunit.result.cache

# Archivos locales del editor y del sistema
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archivos temporales de diagnóstico
/public/diagnostico.php
